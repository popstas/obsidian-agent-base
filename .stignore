// .stignore этого устройства. Syncthing его НЕ синхронизирует между машинами —
// он приезжает вместе с клоном репозитория (в отличие от .stignore-common,
// который Syncthing разносит сам).
//
// Если вольт попал на машину не через git, а только по синку, заведи такой файл руками:
// достаточно одной строки #include ниже.

#include .stignore-common

// ---- Локальные правила только для этой машины ----
// Добавляй ниже. Помни: первое совпадение выигрывает,
// поэтому "!"-исключения для правил из common нужно ставить ВЫШЕ #include.
