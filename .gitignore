# Автогенерируется хуком из tasks.md
files/tasks.json

# Obsidian: per-machine state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace.json.bak
.obsidian/*.sync-conflict-*.json
.obsidian/graph.json
.obsidian/.trash/
.trash/
.DS_Store

# Чужие Obsidian-плагины ставятся скриптом, в репозиторий не коммитятся.
# Свой tasks-mover — исключение, он вендорится.
.obsidian/plugins/*
!.obsidian/plugins/tasks-mover/

# У двух плагинов vault владеет не кодом, а настройками: file-explorer-plus
# прячет AGENTS.md из дерева файлов, obsidian-icon-folder держит иконки файлов
# лестницы. Каталог приходится переоткрыть, иначе git в него не заглядывает,
# и заново закрыть всё, кроме data.json — код по-прежнему ставит скрипт.
!.obsidian/plugins/file-explorer-plus/
.obsidian/plugins/file-explorer-plus/*
!.obsidian/plugins/file-explorer-plus/data.json
!.obsidian/plugins/obsidian-icon-folder/
.obsidian/plugins/obsidian-icon-folder/*
!.obsidian/plugins/obsidian-icon-folder/data.json

# Приватные рабочие материалы автора (планы/спеки/SDD) — не для публичного репо.
docs/superpowers/
.superpowers/

# Проектно-специфичные приватные термины для guard-теста (см. .privacy-terms.example)
.privacy-terms
