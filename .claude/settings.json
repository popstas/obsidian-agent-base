{
  "extraKnownMarketplaces": {
    "obsidian-agent-workspace": {
      "source": { "source": "directory", "path": "." }
    }
  },
  "enabledPlugins": {
    "obsidian-agent-workspace@obsidian-agent-workspace": true
  },
  "env": {
    "STATUSLINE_TODO": "tasks.md"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/tasks-changed.mjs" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/gen-tasks-json.cjs" },
          { "type": "command", "command": "node .claude/hooks/tasks-startup.mjs" }
        ]
      }
    ]
  }
}
