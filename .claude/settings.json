{
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.cjs"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | grep -qF 'tasks.md' && node .claude/gen-tasks-json.cjs || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/gen-tasks-json.cjs || true"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tasks-startup.sh"
          }
        ]
      }
    ]
  }
}
