{
  "$comment": "Плагины vault. enabled — попадает в .obsidian/community-plugins.json; vendored — лежит в репозитории, скриптом не качается.",
  "plugins": [
    { "id": "tasks-mover", "repo": "popstas/obsidian-agent-base", "minVersion": "1.0.0", "enabled": true, "vendored": true },
    { "id": "dataview", "repo": "blacksmithgu/obsidian-dataview", "minVersion": "0.5.68", "note": "не поднимай до тега 0.5.70: manifest.json внутри этого релиза несёт version 0.5.68, а установщик сверяет именно его — более высокий minVersion недостижим и уйдёт в вечную перекачку", "enabled": true },
    { "id": "obsidian-tasks-plugin", "repo": "obsidian-tasks-group/obsidian-tasks", "minVersion": "8.3.0", "enabled": true },
    { "id": "obsidian-outliner", "repo": "vslinko/obsidian-outliner", "minVersion": "4.10.2", "enabled": true },
    { "id": "various-complements", "repo": "tadashi-aikawa/obsidian-various-complements-plugin", "minVersion": "11.4.0", "enabled": true },
    { "id": "obsidian-icon-folder", "repo": "florianwoelki/obsidian-iconize", "minVersion": "2.14.7", "enabled": true },
    { "id": "table-editor-obsidian", "repo": "tgrosinger/advanced-tables-obsidian", "minVersion": "0.23.2", "enabled": true },
    { "id": "image-captions", "repo": "alangrainger/obsidian-image-captions", "minVersion": "1.1.7", "enabled": true },
    { "id": "file-explorer-plus", "repo": "kelszo/obsidian-file-explorer-plus", "minVersion": "1.3.1", "enabled": true },
    { "id": "obsidian-local-images-plus", "repo": "sergei-korneev/obsidian-local-images-plus", "minVersion": "0.16.4", "enabled": true },
    { "id": "claude-sidebar", "repo": "derek-larson14/obsidian-claude-sidebar", "minVersion": "1.8.16", "enabled": true },
    { "id": "obsidian-excel-to-markdown-table", "repo": "ganesshkumar/obsidian-excel-to-markdown-table", "minVersion": "0.4.0", "enabled": true }
  ]
}
